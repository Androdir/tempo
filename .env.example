# Required: devices exchange this one-time admin secret for individual tokens.
# Generate one with: openssl rand -hex 24
TEMPO_PAIRING_SECRET=replace-with-a-long-random-secret

# Keep the Docker-published port private to the Pi. Tailscale Serve proxies it.
# Use 0.0.0.0 only if you intentionally want direct LAN access too.
TEMPO_HOST_BIND=127.0.0.1
